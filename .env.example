# App
EW_APP_NAME=easyweaver
EW_DEBUG=true
EW_SECRET_KEY=change-me-in-production

# Database (metadata store)
EW_DATABASE_URL=postgresql+asyncpg://easyweaver:easyweaver@localhost:5432/easyweaver

# MongoDB (for testing as a data source)
EW_MONGO_URL=mongodb://easyweaver:easyweaver@localhost:27017

# Redis
EW_REDIS_URL=redis://localhost:6379/0

# Celery
EW_CELERY_BROKER_URL=redis://localhost:6379/1
EW_CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Auth
EW_JWT_SECRET_KEY=change-me-jwt-secret
EW_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
EW_JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption (Fernet key for credential storage)
EW_FERNET_KEY=change-me-generate-with-cryptography-fernet

# Query limits
EW_MAX_RESULT_ROWS=100000
EW_RESULT_TTL_SECONDS=3600
EW_SCHEMA_CACHE_TTL_SECONDS=900

# GCS Storage
EW_GCS_BUCKET_NAME=
EW_GCS_CREDENTIALS_PATH=
EW_GCS_CREDENTIALS_JSON=
EW_FILE_STORAGE_TYPE=redis
